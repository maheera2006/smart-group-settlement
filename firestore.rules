rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users/{uid} ----
    // Anyone signed in can look themselves or other users up by email
    // (needed to add members to a group by email), but only the owner
    // of a profile can write to it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- groups/{groupId} ----
    // Only authenticated members of a group may read it, or its expenses
    // and settlement subcollections. Only members may write, and a write
    // must not remove the writer themselves from memberIds (prevents
    // accidental lockout) nor let a non-member add themselves silently
    // without already being referenced by an existing member's action.
    match /groups/{groupId} {
      allow read: if isMember();
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember();
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      function isMember() {
        return request.auth != null
               && request.auth.uid in resource.data.memberIds;
      }

      function isGroupMember() {
        return request.auth != null
               && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      // ---- groups/{groupId}/expenses/{expenseId} ----
      match /expenses/{expenseId} {
        allow read: if isGroupMember();
        allow create: if isGroupMember()
                      && request.resource.data.paidBy is string
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.participants is list
                      && request.resource.data.participants.size() > 0;
        allow update, delete: if isGroupMember();
      }

      // ---- groups/{groupId}/payments/{paymentId} ----
      // Real settlement-payment ledger entries. These directly affect every
      // future balance calculation, so they get the same validation rigor
      // as expenses: only group members may read or write them, and a
      // write must have a valid from/to/amount shape.
      match /payments/{paymentId} {
        allow read: if isGroupMember();
        allow create: if isGroupMember()
                      && request.resource.data.from is string
                      && request.resource.data.to is string
                      && request.resource.data.from != request.resource.data.to
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.groupId == groupId;
        allow delete: if isGroupMember();
        allow update: if false; // payments are immutable once recorded; undo = delete, not edit
      }
    }
  }
}
